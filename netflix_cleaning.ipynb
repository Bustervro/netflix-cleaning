# Netflix Data Cleaning Assignment
# Part 1: Missing Data
# Part 2: Cleaning Strategies
# Part 3: Date Conversion

import pandas as pd

# PART 1: Load Netflix dataset
netflix_titles = pd.read_csv("netflix_titles.csv")

print("=== PART 1: MISSING DATA ===")

print("\nOriginal shape:")
print(netflix_titles.shape)

print("\nMissing values per column:")
print(netflix_titles.isnull().sum())

print("\nMissing percentages:")
missing_percent = netflix_titles.isnull().mean() * 100
print(missing_percent.round(2))

print("\nColumns with the most missing data:")
print(missing_percent.sort_values(ascending=False).head(3))

# PART 2: Cleaning Strategies

print("\n=== PART 2: CLEANING DATA ===")

# Strategy A: Fill missing director names
netflix_filled = netflix_titles.copy()

netflix_filled["director"] = netflix_filled["director"].fillna(
    "Unknown"
)

print("\nMissing directors after filling:")
print(netflix_filled["director"].isnull().sum())

# Strategy B: Drop rows with missing director or cast
netflix_dropped = netflix_titles.dropna(
    subset=["director", "cast"]
)

print("\nOriginal shape:")
print(netflix_titles.shape)

print("\nShape after dropping:")
print(netflix_dropped.shape)

rows_lost = len(netflix_titles) - len(netflix_dropped)

print("\nTotal rows lost:")
print(rows_lost)

print("\nReflection:")
print("Filling missing values keeps more data.")
print("Dropping rows removes missing information.")
print("Losing too many rows can affect the accuracy of analysis.")

# PART 3: Date Conversion

print("\n=== PART 3: DATE CONVERSION ===")

print("\nDate type before conversion:")
print(netflix_filled["date_added"].dtype)

# Convert text into datetime
netflix_filled["date_added"] = pd.to_datetime(
    netflix_filled["date_added"].str.strip(),
    errors="coerce"
)

print("\nData information after conversion:")
netflix_filled.info()

# Extract day from date
netflix_filled["day_added"] = netflix_filled[
    "date_added"
].dt.day

print("\nFirst 5 rows after cleaning:")
print(netflix_filled.head())

print("\n=== ASSIGNMENT COMPLETED ===")
